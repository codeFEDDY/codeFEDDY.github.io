{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codefeddy-control-plane",
  "main": "src/entry.js",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mcp.codefeddy.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY_HUB",
        "class_name": "RegistryHub"
      },
      {
        "name": "PRODUCT_HUB",
        "class_name": "ProductHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RegistryHub",
        "ProductHub"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}

